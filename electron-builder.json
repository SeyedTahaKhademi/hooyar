{
  "appId": "com.hooyar.ai.agent",
  "productName": "Hooyar",
  "copyright": "Copyright © 2026 Hooyar AI",
  "asar": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "assets/**/*"
  ],
  "win": {
    "sign": null,
    "signingHashAlgorithms": null,
    "icon": "assets/hooyar.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hooyar",
    "installerIcon": "assets/hooyar.ico",
    "uninstallerIcon": "assets/hooyar.ico",
    "installerHeaderIcon": "assets/hooyar.ico"
  },
  "publish": {
    "provider": "github",
    "owner": "seyedtahakhademi",
    "repo": "hooyar"
  }
}